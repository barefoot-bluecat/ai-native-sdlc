# Claude Code on Microsoft Foundry
# Copy to .env (gitignored). Auth is Entra ID via `az login`.
# Leave ANTHROPIC_FOUNDRY_API_KEY unset so the default credential chain is used.

CLAUDE_CODE_USE_FOUNDRY=1

# Resource name only. Claude Code rejects URLs and host names here.
ANTHROPIC_FOUNDRY_RESOURCE=your-foundry-resource

# Pin every alias to a deployment you actually have. Foundry has no startup
# model check, so an unpinned alias fails at request time.
# Name deployments after their model ID to get the 1M context window.
ANTHROPIC_DEFAULT_OPUS_MODEL=your-opus-deployment
ANTHROPIC_DEFAULT_SONNET_MODEL=your-sonnet-deployment
ANTHROPIC_DEFAULT_HAIKU_MODEL=your-haiku-deployment
